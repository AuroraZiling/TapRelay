import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { Button } from "../vendor/components/button.slint";

export component Heading inherits Text {
    font-size: 24px;
    font-weight: 500;
    color: Tokens.color-foreground;
}
export component Caption inherits Text {
    font-size: 14px;
    color: Tokens.color-muted-foreground;
    wrap: word-wrap;
}
export component Label inherits Text {
    font-size: 14px;
    color: Tokens.color-foreground;
    wrap: word-wrap;
}
export component StatusDot inherits Rectangle {
    in property <color> signal;
    in property <length> dot-size: 8px;
    width: 16px;
    height: 16px;
    background: transparent;
    Rectangle {
        x: (parent.width - root.dot-size) / 2;
        y: (parent.height - root.dot-size) / 2;
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: root.signal;
    }
}
export component Panel inherits Rectangle {
    background: Tokens.color-card;
    border-color: Tokens.color-border-hairline;
    border-width: 1px;
    border-radius: 10px;
    @children
}
export component Spinner inherits Rectangle {
    width: 16px;
    height: 16px;
    background: transparent;
    property <float> phase: 0;
    Timer {
        interval: 650ms;
        running: true;
        triggered => {
            root.phase = 1 - root.phase;
        }
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Tokens.color-muted-foreground;
        opacity: root.phase == 0 ? 0.35: 1;
        animate opacity {
            duration: 650ms;
        }
    }
}
export component ErrorBanner inherits Rectangle {
    in property <string> problem;
    in property <bool> retry-allowed;
    in property <bool> busy;
    callback action(string, string);
    vertical-stretch: 0;
    background: Tokens.color-destructive.with-alpha(0.08);
    border-color: Tokens.color-destructive.with-alpha(0.4);
    border-width: 1px;
    border-radius: Tokens.radius-lg;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.problem;
            color: Tokens.color-destructive;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-live-region: polite;
            accessible-id: "error-summary";
        }
        if root.retry-allowed: Button {
            text: I18n.text.common-retry;
            accessible-id: "error-retry";
            variant: outline;
            size: xs;
            disabled: root.busy;
            horizontal-stretch: 0;
            clicked => { root.action("retry", ""); }
        }
    }
}
