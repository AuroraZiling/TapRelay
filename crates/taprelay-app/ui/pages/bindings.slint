import { Switch } from "../vendor/components/switch.slint";
import { Button } from "../vendor/components/button.slint";
import { FocusRing } from "../vendor/components/focus-ring.slint";
import { ScrollArea } from "../vendor/components/scroll-area.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { BindingCaptureState, BindingUi, FunctionBindingRow, ShortcutItem } from "../types.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Caption, Label } from "../components/primitives.slint";
import { IconButton } from "../components/icon-button.slint";
import { Badge } from "../vendor/components/badge.slint";

// Borderless capture surface. BindingChip owns the surrounding visual so this
// module contributes keyboard, pointer and accessibility behavior only.
component ShortcutCapture inherits Rectangle {
    in property <string> text;
    in property <bool> recording;
    in property <bool> disabled: false;
    in property <string> accessibility-label: root.text;
    in property <string> accessibility-description;
    callback begin();
    callback cancel();
    callback key-input(string, bool);
    out property <bool> hovered: !root.disabled && touch.has-hover;
    property <bool> pointer-focus: false;

    width: label.preferred-width;
    height: Tokens.density-button-sm;
    horizontal-stretch: 0;
    background: transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.accessibility-label;
    accessible-description: root.accessibility-description;
    accessible-enabled: !root.disabled;
    accessible-action-default => { root.request-begin(); }

    function request-begin() {
        if !root.disabled && !root.recording {
            focus.focus();
            root.begin();
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.pointer-focus = true;
            }
        }
        clicked => { root.request-begin(); }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.recording ? Tokens.color-foreground : Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: !root.disabled;
        init => {
            if root.recording && !root.disabled {
                self.focus();
            }
        }
        key-pressed(event) => {
            root.pointer-focus = false;
            if root.disabled {
                return reject;
            }
            if root.recording {
                if event.text == Key.Escape {
                    root.cancel();
                } else {
                    root.key-input(event.text, true);
                }
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.begin();
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if root.recording {
                root.key-input(event.text, false);
                return accept;
            }
            return reject;
        }
    }
    changed recording => {
        if self.recording && !root.disabled {
            focus.focus();
        }
    }
    // The recording chip already has its own active visual treatment. Keep
    // the focus ring for normal keyboard navigation, but avoid stacking it
    // around the temporary recording control.
    if focus.has-focus && !root.pointer-focus && !root.recording: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
    }
}

component BindingChip inherits Rectangle {
    in property <string> label;
    in property <bool> recording: false;
    in property <bool> removable: true;
    in property <bool> disabled: false;
    in property <string> accessibility-id;
    in property <string> accessibility-label: root.label;
    in property <string> accessibility-description;
    in property <string> remove-accessibility-id;
    callback begin();
    callback cancel();
    callback remove();
    callback key-input(string, bool);
    out property <bool> hovered: !root.disabled
        && (surface-touch.has-hover || capture.hovered || cancel_button.hovered || remove_button.hovered);

    width: min(measure.preferred-width + 42px, root.available-width);
    in property <length> available-width: 400px;
    height: Tokens.density-button-sm;
    preferred-width: min(measure.preferred-width + 42px, root.available-width);
    horizontal-stretch: 0;
    opacity: root.disabled ? 0.5 : 1;
    background: root.recording
        ? Tokens.color-surface-3
        : root.hovered ? Tokens.color-accent : Tokens.color-card;
    border-width: 1px;
    border-color: Tokens.color-border-hairline;
    border-radius: Tokens.radius-md;
    animate background, opacity {
        duration: Tokens.motion-fast;
        easing: Tokens.motion-easing-standard;
    }
    accessible-role: none;
    measure := Text {
        text: root.label;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // Cover padding and layout gaps as well as the child controls.
    surface-touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { if !root.recording && !root.disabled { root.begin(); } }
    }

    content := HorizontalLayout {
        x: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: Tokens.spacing-sm;
        padding-right: 2px;
        spacing: Tokens.spacing-xs;
        cross-axis-alignment: center;

        capture := ShortcutCapture {
            width: max(0px, parent.width - 42px);
            text: root.label;
            recording: root.recording;
            disabled: root.disabled;
            accessibility-label: root.accessibility-label;
            accessibility-description: root.accessibility-description;
            accessible-id: root.accessibility-id;
            begin => { root.begin(); }
            cancel => { root.cancel(); }
            key-input(text, down) => { root.key-input(text, down); }
        }
        cancel_button := IconButton {
            activate-on-press: true;
            foreground-only: true;
            width: root.recording ? 24px : 0px;
            visible: root.recording;
            size: icon-xs;
            variant: ghost;
            icon: IconSet.X;
            hint: I18n.text.bindings-cancel;
            accessible-enabled: root.recording;
            clicked => { root.cancel(); }
        }
        remove_button := IconButton {
            activate-on-press: true;
            foreground-only: true;
            width: !root.recording && root.removable ? 24px : 0px;
            visible: !root.recording && root.removable;
            size: icon-xs;
            variant: ghost;
            disabled: root.disabled;
            icon: IconSet.X;
            hint: I18n.text.common-delete + ": " + root.label;
            accessible-id: root.remove-accessibility-id;
            icon-color: remove_button.hovered && !root.disabled ? Tokens.color-destructive : Tokens.color-muted-foreground;
            accessible-enabled: !root.recording && root.removable && !root.disabled;
            clicked => { root.remove(); }
        }
    }
}

component AddBindingButton inherits Button {
    in property <string> label;
    text: "";
    size: sm;
    variant: outline;
    accessible-label: root.label;
    width: content.preferred-width + 2 * Tokens.spacing-sm;
    preferred-width: content.preferred-width + 2 * Tokens.spacing-sm;
    horizontal-stretch: 0;
    content := HorizontalLayout {
        x: Tokens.spacing-sm;
        width: self.preferred-width;
        height: parent.height;
        spacing: Tokens.spacing-xs;
        alignment: center;
        cross-axis-alignment: center;
        IconDisplay {
            icon: IconSet.Plus;
            size: 14px;
            stroke: root.content-foreground;
            stroke-width: 1.75;
        }
        Text {
            text: root.label;
            color: root.content-foreground;
            font-size: Tokens.typography-body-sm-size;
            font-weight: Tokens.typography-weight-medium;
            vertical-alignment: center;
        }
    }
}

component DisabledShortcutChip inherits Rectangle {
    in property <ShortcutItem> shortcut;
    in property <string> accessibility-id;
    in property <length> available-width: 400px;
    width: min(root.available-width, max(92px, label.preferred-width + 2 * Tokens.spacing-sm));
    height: Tokens.density-button-sm;
    horizontal-stretch: 0;
    background: Tokens.color-card;
    border-width: 1px;
    border-color: Tokens.color-border-hairline;
    border-radius: Tokens.radius-md;
    opacity: 0.5;
    accessible-role: text;
    accessible-id: root.accessibility-id;
    accessible-label: root.shortcut.text;
    label := Text {
        x: Tokens.spacing-sm;
        width: parent.width - 2 * Tokens.spacing-sm;
        height: parent.height;
        text: root.shortcut.text;
        color: Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Keep every function in catalog order, including disabled functions.
component FunctionBindingRowView inherits Rectangle {
    in property <FunctionBindingRow> binding-row;
    in property <BindingCaptureState> capture;
    property <bool> inactive: !root.binding-row.enabled;
    property <bool> captures-row: root.capture.function-id == root.binding-row.id;
    property <bool> capture-busy: root.capture.function-id != "";
    property <bool> captures-new-slot:
        root.captures-row && root.capture.slot == root.binding-row.shortcuts.length;
    property <bool> has-error: root.capture.error != "" && root.captures-row;

    in property <length> row-padding: 16px;
    in property <length> column-spacing: 16px;
    property <length> chip-spacing: 8px;
    in property <length> switch-width: 36px;
    in property <length> function-column-width: 300px;
    property <length> shortcut-column-width: max(0px,
        root.width - 2 * root.row-padding - 2 * root.column-spacing
        - root.switch-width - root.function-column-width);
    property <bool> two-shortcut-columns:
        root.binding-row.shortcuts.length > 1
        || (!root.inactive && root.binding-row.shortcuts.length == 1);
    property <length> shortcut-control-width: root.two-shortcut-columns
        ? (root.shortcut-column-width - root.chip-spacing) / 2
        : root.shortcut-column-width;

    callback begin-binding-capture(string, int);
    callback cancel-binding-capture();
    callback delete-binding-shortcut(string, int);
    callback set-binding-function-enabled(string, bool);
    callback binding-key-input(string, bool);

    height: root.has-error ? 88px : 64px;
    background: Tokens.color-card;
    border-radius: Tokens.radius-md;
    HorizontalLayout {
        padding-left: root.row-padding;
        padding-right: root.row-padding;
        height: root.height;
        spacing: root.column-spacing;
        cross-axis-alignment: center;
        Switch {
            width: root.switch-width;
            height: 20px;
            checked: root.binding-row.enabled;
            disabled: root.capture-busy;
            accessible-id: "binding-enabled-" + root.binding-row.id;
            accessible-label: root.binding-row.label;
            toggled(enabled) => {
                root.set-binding-function-enabled(root.binding-row.id, enabled);
            }
        }
        left := VerticalLayout {
            width: root.shortcut-column-width;
            spacing: 4px;
            alignment: center;
            shortcut-controls := Rectangle {
                height: Tokens.density-button-sm;
                vertical-stretch: 0;
                if !root.inactive: HorizontalLayout {
                    spacing: root.chip-spacing;
                    alignment: start;
                    cross-axis-alignment: center;
                    for shortcut in root.binding-row.shortcuts: BindingChip {
                        property <bool> captures-slot:
                            root.captures-row && root.capture.slot == shortcut.slot;
                        available-width: root.shortcut-control-width;
                        label: self.captures-slot ? root.capture.text : shortcut.text;
                        recording: self.captures-slot;
                        disabled: root.capture-busy && !self.captures-slot;
                        accessibility-label: root.binding-row.label + ": " + shortcut.text;
                        accessibility-description: self.captures-slot ? root.capture.error : "";
                        accessibility-id: "binding-slot-" + root.binding-row.id + "-" + shortcut.slot;
                        remove-accessibility-id: "binding-delete-" + root.binding-row.id + "-" + shortcut.slot;
                        key-input(text, down) => { root.binding-key-input(text, down); }
                        begin => { root.begin-binding-capture(root.binding-row.id, shortcut.slot); }
                        cancel => { root.cancel-binding-capture(); }
                        remove => { root.delete-binding-shortcut(root.binding-row.id, shortcut.slot); }
                    }
                    if root.binding-row.shortcuts.length < 2
                            && !root.captures-new-slot: AddBindingButton {
                        label: I18n.text.bindings-unset;
                        accessible-id: "binding-add-" + root.binding-row.id;
                        accessible-label: I18n.text.bindings-add + ": " + root.binding-row.label;
                        disabled: root.capture-busy;
                        clicked => {
                            root.begin-binding-capture(
                                root.binding-row.id,
                                root.binding-row.shortcuts.length,
                            );
                        }
                    }
                    if root.captures-new-slot: BindingChip {
                        available-width: root.shortcut-control-width;
                        label: root.capture.text;
                        recording: true;
                        removable: false;
                        accessibility-label: root.binding-row.label + ": " + root.capture.text;
                        accessibility-description: root.capture.error;
                        accessibility-id: "binding-slot-" + root.binding-row.id + "-" + root.capture.slot;
                        cancel => { root.cancel-binding-capture(); }
                        key-input(text, down) => { root.binding-key-input(text, down); }
                    }
                }
                if root.inactive: HorizontalLayout {
                    spacing: root.chip-spacing;
                    alignment: start;
                    cross-axis-alignment: center;
                    if root.binding-row.shortcuts.length == 0: Caption {
                        text: I18n.text.bindings-unset;
                        opacity: 0.5;
                    }
                    for shortcut in root.binding-row.shortcuts: DisabledShortcutChip {
                        available-width: root.shortcut-control-width;
                        shortcut: shortcut;
                        accessibility-id: "binding-disabled-slot-" + root.binding-row.id + "-" + shortcut.slot;
                    }
                }
            }
            if root.has-error: Text {
                text: root.capture.error;
                color: Tokens.color-destructive;
                font-size: Tokens.typography-body-sm-size;
                height: 20px;
                min-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
                accessible-id: "binding-error-" + root.binding-row.id;
                accessible-live-region: polite;
            }
        }
        // One gesture per line, trigger first: a merged function reads as
        // "Tap → Previous" over "Hold → Rewind" without asking the reader to
        // map a shared trigger word onto a pair of slashed action names.
        HorizontalLayout {
            width: root.function-column-width;
            vertical-stretch: 1;
            accessible-role: groupbox;
            accessible-id: "binding-function-" + root.binding-row.id;
            accessible-label: root.binding-row.label;
            VerticalLayout {
                alignment: center;
                spacing: 0px;
                for gesture in root.binding-row.gestures: HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Label {
                        text: gesture.gesture;
                        color: Tokens.color-muted-foreground;
                        width: 40px;
                        vertical-alignment: center;
                        opacity: root.inactive ? 0.5 : 1;
                    }
                    IconDisplay { icon: IconSet.ArrowRight; size: 16px; stroke: Tokens.color-muted-foreground; }
                    Badge {
                        text: gesture.action;
                        variant: secondary;
                        opacity: root.inactive ? 0.5 : 1;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }

}

export component FunctionBindingsPage inherits VerticalLayout {
    property <length> row-padding: 16px;
    property <length> column-spacing: 16px;
    property <length> switch-width: 36px;
    property <length> function-column-width: 300px;
    spacing: 24px;
    Caption { text: I18n.text.bindings-help; vertical-stretch: 0; }
    ScrollArea {
        drag-to-scroll: false;
        content-height: max(self.height, content.preferred-height);
        content := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: self.preferred-height;
            spacing: 8px;
            alignment: start;
            if BindingUi.rows.length > 0: HorizontalLayout {
                height: 28px;
                padding-left: root.row-padding;
                padding-right: root.row-padding;
                spacing: root.column-spacing;
                Caption { text: I18n.text.bindings-column-enabled; width: root.switch-width; }
                Caption { text: I18n.text.bindings-column-shortcut; horizontal-stretch: 1; }
                Caption { text: I18n.text.bindings-column-function; width: root.function-column-width; }
            }
            for row in BindingUi.rows: FunctionBindingRowView {
                binding-row: row;
                capture: BindingUi.capture;
                row-padding: root.row-padding;
                column-spacing: root.column-spacing;
                switch-width: root.switch-width;
                function-column-width: root.function-column-width;
                begin-binding-capture(function-id, slot) => {
                    BindingUi.begin-capture(function-id, slot);
                }
                cancel-binding-capture => { BindingUi.cancel-capture(); }
                delete-binding-shortcut(function-id, slot) => {
                    BindingUi.delete-shortcut(function-id, slot);
                }
                set-binding-function-enabled(function-id, enabled) => {
                    BindingUi.set-function-enabled(function-id, enabled);
                }
                binding-key-input(text, down) => { BindingUi.key-input(text, down); }
            }
        }
    }
}
