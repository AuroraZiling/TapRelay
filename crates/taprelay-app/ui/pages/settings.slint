import { Button } from "../vendor/components/button.slint";
import { ScrollArea } from "../vendor/components/scroll-area.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { Caption, Label } from "../components/primitives.slint";
import { SwitchRow } from "../components/switch-row.slint";
import { Badge, BadgeVariant } from "../vendor/components/badge.slint";

struct ChoiceOption {
    label: string,
    value: string,
}

export { ChoiceOption }

component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> badge;
    in property <BadgeVariant> badge-variant: BadgeVariant.default;
    spacing: 16px;
    cross-axis-alignment: start;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;
        Text {
            horizontal-stretch: 0;
            text: root.title;
            color: Tokens.color-foreground;
            font-size: 16px;
            font-weight: 500;
        }
        if root.badge != "": Badge {
            horizontal-stretch: 0;
            text: root.badge;
            size: sm;
            variant: root.badge-variant;
        }
    }
    @children
}
export component SettingsPage inherits ScrollArea {
    in-out property <bool> always-admin;
    in property <string> app-version;
    in-out property <bool> auto-listen;
    in-out property <bool> auto-start;
    in-out property <bool> close-to-tray;
    in property <string> data-directory;
    in property <bool> elevated;
    in property <int> language-choice;
    in property <[ChoiceOption]> language-options;
    in-out property <bool> notifications;
    in-out property <bool> connection-wait-warning;
    in-out property <bool> start-hidden;
    in property <int> theme-choice;
    callback action(string, string);
    property <[ChoiceOption]> theme-options: [
        { label: I18n.text.theme-system, value: "system" },
        { label: I18n.text.theme-light, value: "light" },
        { label: I18n.text.theme-dark, value: "dark" },
    ];
    content-height: settings.preferred-height;
    settings := VerticalLayout {
        width: parent.width;
        padding-right: 12px;
        spacing: 28px;
        alignment: start;
        Section {
            title: I18n.text.settings-appearance;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                for option[i] in root.theme-options: Button {
                    text: option.label;
                    variant: root.theme-choice == i ? secondary: outline;
                    clicked=> {
                        root.action("theme", option.value);
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                for option[i] in root.language-options: Button {
                    text: option.label;
                    variant: root.language-choice == i ? secondary: outline;
                    clicked=> {
                        root.action("language", option.value);
                    }
                }
            }
        }
        Section {
            title: I18n.text.settings-startup;
            SwitchRow {
                label: I18n.text.settings-autostart;
                accessibility-id: "setting-autostart";
                checked <=> root.auto-start;
                toggled(v)=> {
                    root.action("set-autostart", v ? "1" : "0");
                }
            }
            SwitchRow {
                label: I18n.text.settings-hidden;
                accessibility-id: "setting-start-hidden";
                checked <=> root.start-hidden;
                toggled(v)=> {
                    root.action("set-start-hidden", v ? "1" : "0");
                }
            }
            SwitchRow {
                label: I18n.text.settings-auto-listen;
                accessibility-id: "setting-auto-listen";
                checked <=> root.auto-listen;
                toggled(v)=> {
                    root.action("set-auto-listen", v ? "1" : "0");
                }
            }
            SwitchRow {
                label: I18n.text.settings-close-tray;
                description: I18n.text.settings-close-hint;
                accessibility-id: "setting-close-to-tray";
                checked <=> root.close-to-tray;
                toggled(v)=> {
                    root.action("set-close-to-tray", v ? "1" : "0");
                }
            }
        }
        Section {
            title: I18n.text.settings-app-permissions;
            badge: root.elevated ? I18n.text.permissions-badge-administrator : I18n.text.permissions-badge-user;
            badge-variant: root.elevated ? BadgeVariant.info : BadgeVariant.success;
            SwitchRow {
                label: I18n.text.settings-always-admin;
                description: I18n.text.settings-always-admin-hint;
                accessibility-id: "setting-always-admin";
                checked <=> root.always-admin;
                toggled(v)=> {
                    root.action("set-always-admin", v ? "1" : "0");
                }
            }
            Button {
                text: I18n.text.permissions-restart;
                variant: outline;
                horizontal-stretch: 0;
                disabled: root.elevated;
                clicked=> {
                    root.action("elevate", "");
                }
            }
        }
        Section {
            title: I18n.text.settings-notifications;
            SwitchRow {
                label: I18n.text.settings-connection-wait-warning;
                description: I18n.text.settings-connection-wait-warning-hint;
                accessibility-id: "setting-connection-wait-warning";
                checked <=> root.connection-wait-warning;
                toggled(v)=> {
                    root.action("set-connection-wait-warning", v ? "1" : "0");
                }
            }
            SwitchRow {
                label: I18n.text.settings-notifications-toggle;
                description: I18n.text.settings-notifications-hint;
                accessibility-id: "setting-notifications";
                checked <=> root.notifications;
                toggled(v)=> {
                    root.action("set-notifications", v ? "1" : "0");
                }
            }
        }
        Section {
            title: I18n.text.settings-licensing;
            badge: "GPL-3.0-only";
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: I18n.text.settings-license;
                    accessible-id: "settings-license";
                    variant: link;
                    clicked => { root.action("license", ""); }
                }
                Button {
                    text: I18n.text.settings-third-party-notices;
                    accessible-id: "settings-third-party-notices";
                    variant: link;
                    clicked => { root.action("third-party-notices", ""); }
                }
            }
        }
        Section {
            title: I18n.text.settings-about;
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    alignment: start;
                    cross-axis-alignment: center;
                    spacing: 8px;
                    Label {
                        horizontal-stretch: 0;
                        text: "TapRelay " + root.app-version;
                    }
                    Button {
                        text: I18n.text.settings-repository;
                        accessible-id: "settings-repository";
                        variant: link;
                        clicked => { root.action("repository", ""); }
                    }
                }
                Caption {
                    text: root.data-directory;
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: I18n.text.settings-data-folder;
                    variant: outline;
                    clicked=> {
                        root.action("data-folder", "");
                    }
                }
                Button {
                    text: I18n.text.logs-folder;
                    variant: outline;
                    clicked=> {
                        root.action("logs-folder", "");
                    }
                }
                Button {
                    text: I18n.text.settings-wizard;
                    variant: outline;
                    clicked=> {
                        root.action("wizard", "");
                    }
                }
            }
        }
    }
}
