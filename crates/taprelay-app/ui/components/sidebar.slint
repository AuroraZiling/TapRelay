import { ButtonVariant } from "../vendor/components/button.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { IconButton } from "icon-button.slint";
import { NavEntry, Navigation } from "../navigation.slint";

component NavButton inherits IconButton {
    in property <NavEntry> entry;
    in property <int> current-page: 0;
    callback navigate(int);

    hint: root.entry.label;
    icon: root.entry.icon;
    size: icon;
    width: 36px;
    horizontal-stretch: 0;
    variant: root.entry.page == root.current-page ? ButtonVariant.default : ButtonVariant.ghost;
    clicked => {
        root.navigate(root.entry.page);
    }
}

export component Sidebar inherits Rectangle {
    in-out property <int> page: 0;
    callback action(string, int, string);
    width: 60px;
    background: Tokens.color-card;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        for entry in Navigation.main: NavButton {
            entry: entry;
            current-page: root.page;
            navigate(target) => {
                root.action("navigate", target, "");
            }
        }
        Rectangle { vertical-stretch: 1; }
        for entry in Navigation.pinned: NavButton {
            entry: entry;
            current-page: root.page;
            navigate(target) => {
                root.action("navigate", target, "");
            }
        }
    }
}
