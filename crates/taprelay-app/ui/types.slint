export struct ShortcutItem { text: string, keys: [string], slot: int, enabled: bool }
export struct BindingCaptureState {
    function-id: string,
    slot: int,
    text: string,
    error: string
}
// One way a function reacts to its shortcut: a tapped "Previous" and a held
// "Rewind" are the same binding, so the row lists both gestures.
export struct GestureAction { gesture: string, action: string }
export struct FunctionBindingRow {
    id: string,
    label: string,
    gestures: [GestureAction],
    enabled: bool,
    shortcuts: [ShortcutItem],
    scope-label: string,
    scope-editable: bool,
}
export struct ForegroundAppGroupRow { id: string, name: string, count: int, count-label: string, summary: string }
export struct ForegroundAppRow { path: string, name: string }
export struct ForegroundAppScopeOption { id: string, name: string, checked: bool }
export global ForegroundAppUi {
    in-out property <string> scope-function;
    in property <[ForegroundAppScopeOption]> scope-options;
    callback open-scope(string);
    in property <int> icon-revision;
    pure callback app-icon(string, int) -> image;
    pure callback has-icon(string, int) -> bool;
    pure callback app-name(string, int) -> string;
    pure callback app-missing(string, int) -> bool;
    callback request-icon(string);
    in property <[ForegroundAppGroupRow]> groups;
    in property <[ForegroundAppRow]> foreground-apps;
    in property <[ForegroundAppRow]> running;
    in property <bool> busy;
    in property <bool> saving;
    in-out property <bool> editor-open;
    in-out property <string> selected-id;
    in-out property <string> selected-name;
    in-out property <string> error;
    in-out property <string> form-error;
    in-out property <string> deletion-warning;
    in-out property <bool> confirming-delete;
    in-out property <bool> choosing-running;
    callback command(string, string);
    in-out property <int> focus-request;
    callback set-scope(string, string);
}
// Single host/UI seam for binding presentation. Rust owns the source of truth;
// Slint renders the snapshot and reports typed user intent through callbacks.
export global BindingUi {
    in property <[FunctionBindingRow]> rows;
    in property <BindingCaptureState> capture;
    callback begin-capture(string, int);
    callback cancel-capture();
    callback delete-shortcut(string, int);
    callback set-function-enabled(string, bool);
    callback key-input(string, bool);
}
export struct BindingRow { text: string, keys: [string], enabled: bool, function-name: string }
export struct DeviceRow { id: string, name: string, detail: string, selected: bool, action: string, action-label: string, enabled: bool, paired: bool, device-kind: string, status: string }
export struct CheckRow { title: string, state: int }
export struct RelayStatus {
    device-name: string,
    device-selected: bool,
    listening: bool,
    ready: bool,
    show-retry: bool,
    signal: color,
    stage: string,
    input-count: int
}
export struct MappingRow { id: string, name: string, input: string, output: string, scope: string, enabled: bool }
export struct MappingOutputOption { label: string, value: string, is-mouse: bool }
export global MappingUi {
    in property <[MappingRow]> rows;
    in property <bool> open;
    in property <bool> editor;
    in property <bool> new-mapping;
    in-out property <int> focus-request;
    in-out property <int> leave-focus-request;
    in property <bool> busy;
    in property <bool> saving;
    in-out property <string> name;
    in property <[string]> inputs;
    in property <[MappingOutputOption]> output-options;
    in property <MappingOutputOption> selected-output;
    in property <string> output-filter;
    in-out property <int> entry-mode;
    in-out property <bool> ctrl;
    in-out property <bool> shift;
    in-out property <bool> alt;
    in-out property <bool> meta;
    in property <[ForegroundAppScopeOption]> scopes;
    in property <string> scope-label;
    in property <string> input-error;
    in property <string> capture-error;
    in property <string> error;
    in property <string> conflict-target;
    in property <string> capture-text;
    in property <int> capture-slot: -1;
    in property <bool> can-undo;
    callback command(string, string);
}
