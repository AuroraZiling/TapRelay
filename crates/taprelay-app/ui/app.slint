import { Tokens, Theme, ThemeMode } from "vendor/theme/tokens.slint";
import { Palette } from "std-widgets.slint";
import { BluetoothStatus } from "components/bluetooth-status.slint";
import { I18n, TranslationText } from "@i18n";
import { BindingCaptureState, BindingUi, BindingRow, DeviceRow, CheckRow, FunctionBindingRow, GestureAction, ShortcutItem, RelayStatus } from "types.slint";
import { Heading, ErrorBanner } from "components/primitives.slint";
import { Navigation } from "navigation.slint";
import { Sidebar } from "components/sidebar.slint";
import { Toast } from "components/toast.slint";
import { EnvironmentPage } from "pages/environment.slint";
import { WizardPage } from "pages/wizard.slint";
import { OverviewPage } from "pages/overview.slint";
import { FunctionBindingsPage } from "pages/bindings.slint";
import { ForegroundAppGroupsPage } from "pages/foreground-app-groups.slint";
import { ForegroundAppGroupDeleteDialog } from "components/foreground-app-group-dialog.slint";
import { ForegroundAppGroupEditor } from "pages/foreground-app-group-editor.slint";
import { ForegroundAppUi, MappingUi } from "types.slint";
import { CustomMappingsPage } from "pages/custom-mappings.slint";
import { CustomMappingEditor, MappingLeaveDialog } from "pages/custom-mapping-editor.slint";
export { MappingUi, MappingRow } from "types.slint";
import { Button } from "vendor/components/button.slint";
import { BreadcrumbSeparator } from "components/breadcrumb-separator.slint";
export { ForegroundAppUi, ForegroundAppGroupRow, ForegroundAppRow } from "types.slint";
import { DevicesPage } from "pages/devices.slint";
import { ReceiverActions } from "components/receiver-actions.slint";
import { ChoiceOption, SettingsPage } from "pages/settings.slint";
export { Theme, ThemeMode, I18n, TranslationText, BindingCaptureState, BindingUi, BindingRow, DeviceRow, CheckRow, FunctionBindingRow, GestureAction, ShortcutItem, RelayStatus, ChoiceOption }

export component AppWindow inherits Window {
    property <ColorScheme> widget-color-scheme: Theme.mode == ThemeMode.dark ? ColorScheme.dark : ColorScheme.light;
    init => { Palette.color-scheme = root.widget-color-scheme; }
    changed widget-color-scheme => { Palette.color-scheme = root.widget-color-scheme; }
    out property <color> overlay-background: Tokens.color-card;
    out property <color> overlay-foreground: Tokens.color-foreground;
    title: "TapRelay";
    preferred-width: 900px;
    preferred-height: 500px;
    min-width: 900px;
    min-height: 500px;
    background: Tokens.color-background;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    // Set after native window creation so Windows receives both icon sizes.
    out property <image> app-icon-artwork: @image-url("../resources/taprelay-128.png");
    in property <image> app-icon;
    icon: root.app-icon;
    in-out property <int> mode: 0;
    in-out property <int> page: 0;
    in-out property <int> wizard-page: 0;
    in property <[BindingRow]> bindings;
    in property <[CheckRow]> checks;
    in property <bool> listening;
    in property <bool> ready;
    in property <bool> receiver-next-allowed;
    in property <string> discovery-status;
    in property <string> adapter-label;
    in property <bool> scanning;
    in property <[DeviceRow]> paired-devices;
    in property <bool> bluetooth-available;
    in property <bool> busy;
    in property <bool> elevated;
    in property <string> device-name;
    in property <bool> device-selected;
    in property <string> stage;
    in property <string> stage-detail;
    in property <string> diagnostics;
    in property <string> problem;
    in property <int> input-count;
    in property <string> toast;
    in property <int> state-color: 2;
    in property <string> data-directory;
    in property <string> app-version;
    in-out property <bool> auto-listen;
    in-out property <bool> passthrough-overlay;
    in-out property <bool> passthrough-reverse-scroll;
    in property <int> passthrough-mouse-report-rate;
    in-out property <bool> auto-start;
    in-out property <bool> start-hidden;
    in-out property <bool> close-to-tray;
    in-out property <bool> always-admin;
    in-out property <bool> notifications;
    in-out property <bool> connection-wait-warning;
    in property <int> theme-choice;
    in property <int> language-choice;
    in property <[ChoiceOption]> language-options;
    callback action(string, string);
    public function show-group-editor() { root.page = Navigation.groups.page; ForegroundAppUi.editor-open = true; ForegroundAppUi.focus-request += 1; }
    public function show-mapping-leave() { mapping-leave.show(); MappingUi.leave-focus-request += 1; }
    public function close-mapping-leave() { mapping-leave.close(); MappingUi.focus-request += 1; }
    public function close-group-editor() { ForegroundAppUi.editor-open = false; }
    public function show-group-delete() { group-delete.show(); ForegroundAppUi.focus-request += 1; }
    public function close-group-delete() { group-delete.close(); }
    property <color> signal: root.state-color == 0 ? Tokens.color-success : root.state-color == 1 ? Tokens.color-muted-foreground : root.state-color == 2 ? Tokens.color-warning : Tokens.color-destructive;
    property <RelayStatus> relay-status: {
        device-name: root.device-name,
        device-selected: root.device-selected,
        listening: root.listening,
        ready: root.ready,
        show-retry: root.state-color != 0,
        signal: root.signal,
        stage: root.stage,
        input-count: root.input-count
    };
    HorizontalLayout {
        spacing: 0px;
        if root.mode == 2: Sidebar {
            page <=> root.page;
            action(name, value) => {
                root.action(name, value);
            }
        }
        VerticalLayout {
            padding: 28px;
            spacing: 20px;
            if root.mode == 0 || root.mode == 3: EnvironmentPage {
                busy: root.busy;
                checks: root.checks;
                fatal: root.mode == 3;
                problem: root.problem;
                action(name, value) => {
                    root.action(name, value);
                }
            }
            if root.mode == 1: WizardPage {
                adapter-label: root.adapter-label;
                bluetooth-available: root.bluetooth-available;
                busy: root.busy;
                discovery-status: root.discovery-status;
                scanning: root.scanning;
                paired-devices: root.paired-devices;
                elevated: root.elevated;
                problem: root.problem;
                relay-status: root.relay-status;
                receiver-next-allowed: root.receiver-next-allowed;
                step: root.wizard-page <= 1 ? 0 : root.wizard-page - 1;
                action(name, value) => {
                    root.action(name, value);
                }
            }
            if root.mode == 2: VerticalLayout {
                spacing: 18px;
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 0;
                    page-heading := Heading {
                        horizontal-stretch: 0;
                        text: Navigation.pages[root.page].label;
                        accessible-id: "page-title";
                    }
                    if root.page == Navigation.groups.page && ForegroundAppUi.editor-open: BreadcrumbSeparator {
                        height: page-heading.preferred-height;
                    }
                    if root.page == Navigation.groups.page && ForegroundAppUi.editor-open: Heading {
                        text: ForegroundAppUi.selected-id == "" ? I18n.text.common-new : I18n.text.common-edit;
                        horizontal-stretch: 0;
                        accessible-id: "groups-subpage-title";
                    }

                    if root.page == Navigation.bindings.page && MappingUi.open: BreadcrumbSeparator {
                        height: page-heading.preferred-height;
                    }
                    if root.page == Navigation.bindings.page && MappingUi.open: Heading {
                        text: I18n.text.mappings-title;
                        horizontal-stretch: 0;
                        accessible-id: "mappings-subpage-title";
                    }
                    if root.page == Navigation.bindings.page && MappingUi.editor: BreadcrumbSeparator {
                        height: page-heading.preferred-height;
                    }
                    if root.page == Navigation.bindings.page && MappingUi.editor: Heading {
                        text: MappingUi.new-mapping ? I18n.text.common-new : I18n.text.common-edit;
                        horizontal-stretch: 0;
                        accessible-id: "mappings-editor-title";
                    }
                    if root.page == Navigation.bindings.page: Rectangle { horizontal-stretch: 1; }
                    if root.page == Navigation.bindings.page && !MappingUi.open: Button {
                        height: page-heading.preferred-height;
                        text: I18n.text.mappings-title;
                        variant: outline;
                        horizontal-stretch: 0;
                        disabled: MappingUi.busy;
                        accessible-id: "mappings-open";
                        clicked => { MappingUi.command("open", ""); }
                    }
                    if root.page == Navigation.bindings.page && MappingUi.open: Button {
                        height: page-heading.preferred-height;
                        accessible-id: "mappings-back";
                        text: I18n.text.common-back;
                        variant: ghost;
                        horizontal-stretch: 0;
                        disabled: MappingUi.saving;
                        clicked => { MappingUi.command("back", ""); }
                    }
                    if root.page == Navigation.bindings.page && MappingUi.open && !MappingUi.editor: Button {
                        height: page-heading.preferred-height;
                        text: I18n.text.mappings-create;
                        horizontal-stretch: 0;
                        disabled: MappingUi.busy;
                        accessible-id: "mappings-create";
                        clicked => { MappingUi.command("create", ""); }
                    }
                    if root.page == Navigation.receiver.page: BluetoothStatus {
                        available: root.bluetooth-available;
                        busy: root.busy;
                        status-label: root.adapter-label;
                    }
                    if root.page == Navigation.receiver.page: Rectangle { horizontal-stretch: 1; }
                    if root.page == Navigation.receiver.page: ReceiverActions {
                        action(name, value) => { root.action(name, value); }
                    }
                    if root.page == Navigation.groups.page: Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.page == Navigation.groups.page && !ForegroundAppUi.editor-open: Button {
                        text: I18n.text.common-new;
                        height: page-heading.preferred-height;
                        accessible-id: "groups-create";
                        horizontal-stretch: 0;
                        disabled: ForegroundAppUi.busy;
                        clicked => { ForegroundAppUi.command("create", ""); }
                    }
                    if root.page == Navigation.groups.page && ForegroundAppUi.editor-open: Button {
                        text: I18n.text.common-back;
                        height: page-heading.preferred-height;
                        horizontal-stretch: 0;
                        variant: ghost;
                        disabled: ForegroundAppUi.saving;
                        accessible-id: "groups-editor-back";
                        clicked => { ForegroundAppUi.command("cancel", ""); }
                    }

                }
                if root.problem != "" && root.page != Navigation.bindings.page: ErrorBanner {
                    problem: root.problem;
                    action(name,value)=> {
                        root.action(name,value);
                    }
                }
                if root.page == Navigation.overview.page: OverviewPage {
                    bindings: root.bindings;
                    binding-count: root.bindings.length;
                    elevated: root.elevated;
                    relay-status: root.relay-status;
                    action(name, value) => {
                        root.action(name, value);
                    }
                }
                if root.page == Navigation.bindings.page && !MappingUi.open: FunctionBindingsPage { }
                if root.page == Navigation.bindings.page && MappingUi.open && !MappingUi.editor: CustomMappingsPage { }
                if root.page == Navigation.bindings.page && MappingUi.editor: CustomMappingEditor { }
                if root.page == Navigation.groups.page && !ForegroundAppUi.editor-open: ForegroundAppGroupsPage { }
                if root.page == Navigation.groups.page && ForegroundAppUi.editor-open: ForegroundAppGroupEditor { }
                if root.page == Navigation.receiver.page: DevicesPage {
                    discovery-status: root.discovery-status;
                    scanning: root.scanning;
                    paired-devices: root.paired-devices;
                    action(name, value) => {
                        root.action(name, value);
                    }
                }

                if root.page == Navigation.settings.page: SettingsPage {
                    always-admin <=> root.always-admin;
                    app-version: root.app-version;
                    auto-listen <=> root.auto-listen;
                    passthrough-overlay <=> root.passthrough-overlay;
                    passthrough-reverse-scroll <=> root.passthrough-reverse-scroll;
                    passthrough-mouse-report-rate: root.passthrough-mouse-report-rate;
                    auto-start <=> root.auto-start;
                    close-to-tray <=> root.close-to-tray;
                    data-directory: root.data-directory;
                    elevated: root.elevated;
                    language-choice: root.language-choice;
                    language-options: root.language-options;
                    notifications <=> root.notifications;
                    connection-wait-warning <=> root.connection-wait-warning;
                    start-hidden <=> root.start-hidden;
                    theme-choice: root.theme-choice;
                    action(name, value) => {
                        root.action(name, value);
                    }
                }
            }
        }
    }
    mapping-leave := PopupWindow {
        x: 0px; y: 0px; width: root.width; height: root.height;
        close-policy: no-auto-close;
        MappingLeaveDialog { }
    }
    group-delete := PopupWindow {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;
        ForegroundAppGroupDeleteDialog { }
    }
    if root.toast != "": Toast {
        message: root.toast;
        x: max(20px, root.width - 460px);
        y: root.height - self.height - 20px;
        width: min(440px, root.width - 40px);
    }
}
