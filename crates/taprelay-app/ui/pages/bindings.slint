import { Switch } from "../vendor/components/switch.slint";
import { Button } from "../vendor/components/button.slint";
import { FocusRing } from "../vendor/components/focus-ring.slint";
import { ScrollArea } from "../vendor/components/scroll-area.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { FunctionBindingRow, ShortcutItem } from "../types.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Caption, Label } from "../components/primitives.slint";
import { IconButton } from "../components/icon-button.slint";
import { Badge } from "../vendor/components/badge.slint";


// Borderless, content-sized capture surface. BindingChip owns the visible
// surface so the capture interaction never adds a second input border.
component ShortcutCapture inherits Rectangle {
    in property <string> text;
    in property <bool> recording;
    callback begin();
    callback cancel();
    callback key-input(string, bool);
    out property <bool> hovered: touch.has-hover;
    property <bool> pointer-focus: false;

    width: label.preferred-width;
    height: Tokens.density-button-sm;
    horizontal-stretch: 0;
    background: transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: true;

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.pointer-focus = true;
            }
        }
        clicked => {
            focus.focus();
            if !root.recording {
                root.begin();
            }
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.recording ? Tokens.color-foreground : Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        init => {
            if root.recording {
                self.focus();
            }
        }
        key-pressed(event) => {
            root.pointer-focus = false;
            if root.recording {
                if event.text == Key.Escape {
                    root.cancel();
                } else {
                    root.key-input(event.text, true);
                }
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.begin();
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if root.recording {
                root.key-input(event.text, false);
                return accept;
            }
            return reject;
        }
    }
    changed recording => {
        if self.recording {
            focus.focus();
        }
    }
    // The recording chip already has its own active visual treatment. Keep
    // the focus ring for normal keyboard navigation, but avoid stacking it
    // around the temporary recording control.
    if focus.has-focus && !root.pointer-focus && !root.recording: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
    }
}

component BindingChip inherits Rectangle {
    in property <string> label;
    in property <bool> recording: false;
    in property <bool> removable: true;
    in property <bool> remove-disabled: false;
    callback begin();
    callback cancel();
    callback remove();
    callback key-input(string, bool);
    out property <bool> hovered:
        surface-touch.has-hover || capture.hovered || cancel_button.hovered || remove_button.hovered;

    width: min(measure.preferred-width + 42px, root.available-width);
    in property <length> available-width: 400px;
    height: Tokens.density-button-sm;
    preferred-width: min(measure.preferred-width + 42px, root.available-width);
    horizontal-stretch: 0;
    background: root.recording
        ? Tokens.color-surface-3
        : root.hovered ? Tokens.color-accent : Tokens.color-card;
    border-width: 1px;
    border-color: Tokens.color-border-hairline;
    border-radius: Tokens.radius-md;
    animate background {
        duration: Tokens.motion-fast;
        easing: Tokens.motion-easing-standard;
    }
    accessible-role: none;
    measure := Text {
        text: root.label;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // Cover padding and layout gaps as well as the child controls.
    surface-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if !root.recording { root.begin(); } }
    }

    content := HorizontalLayout {
        x: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: Tokens.spacing-sm;
        padding-right: 2px;
        spacing: Tokens.spacing-xs;
        cross-axis-alignment: center;

        capture := ShortcutCapture {
            width: max(0px, parent.width - 42px);
            text: root.label;
            recording: root.recording;
            begin => { root.begin(); }
            cancel => { root.cancel(); }
            key-input(text, down) => { root.key-input(text, down); }
        }
        cancel_button := IconButton {
            activate-on-press: true;
            foreground-only: true;
            width: root.recording ? 24px : 0px;
            visible: root.recording;
            size: icon-xs;
            variant: ghost;
            icon: IconSet.X;
            hint: I18n.text.bindings-cancel;
            accessible-enabled: root.recording;
            clicked => { root.cancel(); }
        }
        remove_button := IconButton {
            activate-on-press: true;
            foreground-only: true;
            width: !root.recording && root.removable ? 24px : 0px;
            visible: !root.recording && root.removable;
            size: icon-xs;
            variant: ghost;
            disabled: root.remove-disabled;
            icon: IconSet.X;
            hint: I18n.text.common-delete + ": " + root.label;
            icon-color: remove_button.hovered && !root.remove-disabled ? Tokens.color-destructive : Tokens.color-muted-foreground;
            accessible-enabled: !root.recording && root.removable && !root.remove-disabled;
            clicked => { root.remove(); }
        }
    }
}

// Use the renderer's native rounded border at every scale factor.
component AddBindingButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked();
    out property <bool> hovered: touch.has-hover;
    property <bool> pointer-focus: false;
    property <bool> pressed-down: touch.pressed && !root.disabled;

    width: content.preferred-width + 2 * Tokens.spacing-sm;
    height: Tokens.density-button-sm;
    preferred-width: content.preferred-width + 2 * Tokens.spacing-sm;
    horizontal-stretch: 0;

    opacity: root.disabled ? 0.5 : 1.0;
    background: root.hovered && !root.disabled ? Tokens.color-accent : Tokens.color-background;
    border-width: 1px;
    border-color: root.hovered && !root.disabled
        ? Tokens.color-border-hairline-strong
        : Tokens.color-border-hairline;
    border-radius: Tokens.radius-md;
    animate background, border-color, opacity {
        duration: Tokens.motion-fast;
        easing: Tokens.motion-easing-standard;
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: !root.disabled;

    content := HorizontalLayout {
        x: Tokens.spacing-sm;
        y: root.pressed-down ? 1px : 0px;
        width: self.preferred-width;
        height: parent.height;
        spacing: Tokens.spacing-xs;
        alignment: center;
        cross-axis-alignment: center;
        animate y {
            duration: Tokens.motion-fast;
            easing: Tokens.motion-easing-standard;
        }
        IconDisplay {
            icon: IconSet.Plus;
            size: 14px;
            stroke: root.hovered ? Tokens.color-foreground : Tokens.color-muted-foreground;
            stroke-width: 1.75;
        }
        Text {
            text: root.text;
            color: root.hovered ? Tokens.color-foreground : Tokens.color-muted-foreground;
            font-size: Tokens.typography-body-sm-size;
            font-weight: Tokens.typography-weight-medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        pointer-event(ev) => {
            if !root.disabled
                    && ev.button == PointerEventButton.left
                    && ev.kind == PointerEventKind.down {
                root.pointer-focus = true;
            }
        }
        clicked => {
            if !root.disabled {
                focus-scope.focus();
                root.clicked();
            }
        }
    }
    forward-focus: focus-scope;
    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == Key.Return || event.text == " " {
                if !root.disabled { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    if focus-scope.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
    }
}

component DisabledShortcutChip inherits Rectangle {
    in property <ShortcutItem> shortcut;
    in property <length> available-width: 400px;
    width: min(root.available-width, max(92px, label.preferred-width + 2 * Tokens.spacing-sm));
    height: Tokens.density-button-sm;
    horizontal-stretch: 0;
    background: Tokens.color-card;
    border-width: 1px;
    border-color: Tokens.color-border-hairline;
    border-radius: Tokens.radius-md;
    opacity: 0.5;
    label := Text {
        x: Tokens.spacing-sm;
        width: parent.width - 2 * Tokens.spacing-sm;
        height: parent.height;
        text: root.shortcut.text;
        color: Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
        font-weight: Tokens.typography-weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Keep every function in catalog order, including disabled functions.
component FunctionBindingRowView inherits Rectangle {
    in property <FunctionBindingRow> binding-row;
    property <bool> inactive: !root.binding-row.enabled;
    in property <string> capture-function;
    in property <int> capture-slot: -1;
    in property <string> capture-text;
    in property <string> capture-error;
    callback action(string, int, string);
    property <ShortcutItem> first-shortcut: root.binding-row.shortcuts[0];
    property <bool> has-error: root.capture-error != "" && root.capture-function == root.binding-row.id;
    height: 64px;
    background: Tokens.color-card;
    border-radius: Tokens.radius-md;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        height: 64px;
        spacing: 16px;
        cross-axis-alignment: center;
        Switch {
            width: 36px;
            height: 20px;
            checked: root.binding-row.enabled;
            disabled: root.capture-function != "";
            accessible-role: checkbox;
            accessible-checked: root.binding-row.enabled;
            accessible-enabled: root.capture-function == "";
            accessible-label: root.binding-row.label;
            toggled(enabled) => { root.action("toggle-function", enabled ? 1 : 0, root.binding-row.id); }
        }
        left := HorizontalLayout {
            width: root.width - 400px;

            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            // Present one slot for now; the model retains all saved shortcuts.
            if !root.inactive && root.binding-row.shortcuts.length > 0: BindingChip {
                available-width: root.has-error ? (root.width - 408px) / 2 : root.width - 400px;
                label: root.capture-function == root.binding-row.id && root.capture-slot == root.first-shortcut.slot
                    ? root.capture-text : root.first-shortcut.text;
                recording: root.capture-function == root.binding-row.id && root.capture-slot == root.first-shortcut.slot;
                remove-disabled: root.capture-function != "";
                key-input(text, down) => { root.action("capture-key", down ? 1 : 0, text); }
                begin => { if root.capture-function == "" { root.action("capture", root.first-shortcut.slot, root.binding-row.id); } }
                cancel => { root.action("cancel-capture", 0, ""); }
                remove => { root.action("delete", root.first-shortcut.slot, root.binding-row.id); }
            }
            if root.inactive && root.binding-row.shortcuts.length == 0: Caption {
                text: I18n.text.bindings-unset;
                opacity: 0.5;
            }
            if root.inactive && root.binding-row.shortcuts.length > 0: DisabledShortcutChip {
                available-width: root.width - 400px;
                shortcut: root.first-shortcut;
            }
            if !root.inactive && root.binding-row.shortcuts.length == 0
                    && !(root.capture-function == root.binding-row.id
                        && root.capture-slot == root.binding-row.shortcuts.length): AddBindingButton {
                text: I18n.text.bindings-unset;
                accessible-label: I18n.text.bindings-add;
                disabled: root.capture-function != "";
                clicked => { root.action("capture", root.binding-row.shortcuts.length, root.binding-row.id); }
            }
            if !root.inactive && root.binding-row.shortcuts.length == 0
                    && root.capture-function == root.binding-row.id
                    && root.capture-slot == root.binding-row.shortcuts.length: BindingChip {
                available-width: root.has-error ? (root.width - 408px) / 2 : root.width - 400px;
                label: root.capture-text;
                recording: true;
                removable: false;
                cancel => { root.action("cancel-capture", 0, ""); }
                key-input(text, down) => { root.action("capture-key", down ? 1 : 0, text); }
            }
            if root.has-error: Text {
                text: root.capture-error;
                color: Tokens.color-destructive;
                font-size: Tokens.typography-body-sm-size;
                min-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        // One gesture per line, trigger first: a merged function reads as
        // "Tap → Previous" over "Hold → Rewind" without asking the reader to
        // map a shared trigger word onto a pair of slashed action names.
        HorizontalLayout {
            width: 300px;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 0px;
                for gesture in root.binding-row.gestures: HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Label {
                        text: gesture.gesture;
                        color: Tokens.color-muted-foreground;
                        width: 40px;
                        vertical-alignment: center;
                        opacity: root.inactive ? 0.5 : 1;
                    }
                    IconDisplay { icon: IconSet.ArrowRight; size: 16px; stroke: Tokens.color-muted-foreground; }
                    Badge {
                        text: gesture.action;
                        variant: secondary;
                        opacity: root.inactive ? 0.5 : 1;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }

}

export component FunctionBindingsPage inherits VerticalLayout {
    in property <[FunctionBindingRow]> rows;
    in property <string> capture-function;
    in property <int> capture-slot: -1;
    in property <string> capture-text;
    in property <string> capture-error;
    callback action(string, int, string);
    spacing: 24px;
    Caption { text: I18n.text.bindings-help; vertical-stretch: 0; }
    ScrollArea {
        drag-to-scroll: false;
        content-height: max(self.height, content.preferred-height);
        content := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: self.preferred-height;
            spacing: 8px;
            alignment: start;
            if root.rows.length > 0: HorizontalLayout {
                height: 28px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                Caption { text: I18n.text.bindings-column-enabled; width: 36px; }
                Caption { text: I18n.text.bindings-column-shortcut; horizontal-stretch: 1; }
                Caption { text: I18n.text.bindings-column-function; width: 300px; }
            }
            for row in root.rows: FunctionBindingRowView {
                binding-row: row;
                capture-function: root.capture-function;
                capture-slot: root.capture-slot;
                capture-text: root.capture-text;
                capture-error: root.capture-error;
                action(name, index, value) => { root.action(name, index, value); }
            }
        }
    }
}
