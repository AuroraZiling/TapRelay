import { I18n } from "@i18n";
import { Icon, IconSet } from "@lucide";

export struct NavEntry {
    page: int,
    label: string,
    icon: Icon,
}

export global Navigation {
    out property <NavEntry> overview: {
        page: 0,
        label: I18n.text.nav-overview,
        icon: IconSet.LayoutDashboard,
    };
    out property <NavEntry> bindings: {
        page: 1,
        label: I18n.text.nav-bindings,
        icon: IconSet.Keyboard,
    };
    out property <NavEntry> receiver: {
        page: 2,
        label: I18n.text.nav-receiver,
        icon: IconSet.Bluetooth,
    };
    out property <NavEntry> settings: {
        page: 3,
        label: I18n.text.nav-settings,
        icon: IconSet.Settings,
    };
    out property <NavEntry> groups: {
        page: 4,
        label: I18n.text.nav-groups,
        icon: IconSet.Folder,
    };

    // `main` stacks from the top
    out property <[NavEntry]> main: [overview, bindings, groups, receiver];
    // `pinned` sits at the bottom
    out property <[NavEntry]> pinned: [settings];

    out property <[NavEntry]> pages: [overview, bindings, receiver, settings, groups];
}
