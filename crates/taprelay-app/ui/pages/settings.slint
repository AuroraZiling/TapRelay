import { Button } from "../vendor/components/button.slint";
import { ScrollArea } from "../vendor/components/scroll-area.slint";
import { Switch } from "../vendor/components/switch.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { Caption, Label } from "../components/primitives.slint";

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 16px;
    Text {
        text: root.title;
        color: Tokens.color-foreground;
        font-size: 16px;
        font-weight: 600;
    }
    @children
}
component SettingSwitch inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 20px;
    VerticalLayout {
        spacing: 4px;
        Label {
            text: root.label;
        }
        if root.description != "": Caption {
            text: root.description;
        }
    }
    Switch {
        checked <=> root.checked;
        toggled(value) => {
            root.toggled(value);
        }
    }
}
export component SettingsPage inherits ScrollArea {
    in property <bool> account-admin;
    in-out property <bool> always-admin;
    in property <string> app-version;
    in-out property <bool> auto-listen;
    in-out property <bool> auto-start;
    in-out property <bool> close-to-tray;
    in property <string> data-directory;
    in property <bool> elevated;
    in property <int> language-choice;
    in-out property <bool> notifications;
    in-out property <bool> connection-wait-warning;
    in-out property <bool> start-hidden;
    in property <int> theme-choice;
    callback action(string, int, string);
    content-height: settings.preferred-height;
    settings := VerticalLayout {
        width: parent.width;
        padding-right: 12px;
        spacing: 28px;
        alignment: start;
        Section {
            title: I18n.text.settings-appearance;
            Label {
                text: I18n.text.settings-theme;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                for name[i] in [I18n.text.theme-system,I18n.text.theme-light,I18n.text.theme-dark]: Button {
                    text: name;
                    variant: root.theme-choice == i ? secondary: outline;
                    clicked=> {
                        root.action("theme",i,"");
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                for name[i] in [I18n.text.language-system,I18n.text.language-chinese,I18n.text.language-english]: Button {
                    text: name;
                    variant: root.language-choice == i ? secondary: outline;
                    clicked=> {
                        root.action("language",i,"");
                    }
                }
            }
        }
        Section {
            title: I18n.text.settings-startup;
            SettingSwitch {
                label: I18n.text.settings-autostart;
                checked <=> root.auto-start;
                toggled(v)=> {
                    root.action("setting",0,v?"1":"0");
                }
            }
            SettingSwitch {
                label: I18n.text.settings-hidden;
                checked <=> root.start-hidden;
                toggled(v)=> {
                    root.action("setting",1,v?"1":"0");
                }
            }
            SettingSwitch {
                label: I18n.text.settings-auto-listen;
                checked <=> root.auto-listen;
                toggled(v)=> {
                    root.action("setting",2,v?"1":"0");
                }
            }
            SettingSwitch {
                label: I18n.text.settings-close-tray;
                description: I18n.text.settings-close-hint;
                checked <=> root.close-to-tray;
                toggled(v)=> {
                    root.action("setting",3,v?"1":"0");
                }
            }
        }
        Section {
            title: I18n.text.settings-administrator;
            Caption {
                text: (root.elevated ? I18n.text.permissions-process-elevated : I18n.text.permissions-process-standard) + " · " + (root.account-admin ? I18n.text.permissions-account-admin : I18n.text.permissions-account-standard);
            }
            SettingSwitch {
                label: I18n.text.settings-always-admin;
                description: I18n.text.settings-always-admin-hint;
                checked <=> root.always-admin;
                toggled(v)=> {
                    root.action("setting",4,v?"1":"0");
                }
            }
            Button {
                text: I18n.text.permissions-restart;
                variant: outline;
                disabled: root.elevated;
                clicked=> {
                    root.action("elevate",0,"");
                }
            }
        }
        Section {
            title: I18n.text.settings-notifications;
            SettingSwitch {
                label: I18n.text.settings-connection-wait-warning;
                description: I18n.text.settings-connection-wait-warning-hint;
                checked <=> root.connection-wait-warning;
                toggled(v)=> {
                    root.action("setting",6,v?"1":"0");
                }
            }
            SettingSwitch {
                label: I18n.text.settings-notifications-toggle;
                description: I18n.text.settings-notifications-hint;
                checked <=> root.notifications;
                toggled(v)=> {
                    root.action("setting",5,v?"1":"0");
                }
            }
        }
        Section {
            title: I18n.text.settings-about;
            Label {
                text: "TapRelay " + root.app-version;
            }
            Caption {
                text: root.data-directory;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: I18n.text.settings-data-folder;
                    variant: outline;
                    clicked=> {
                        root.action("data-folder",0,"");
                    }
                }
                Button {
                    text: I18n.text.logs-folder;
                    variant: outline;
                    clicked=> {
                        root.action("logs-folder",0,"");
                    }
                }
                Button {
                    text: I18n.text.settings-wizard;
                    variant: outline;
                    clicked=> {
                        root.action("wizard",0,"");
                    }
                }
            }
        }
    }
}
