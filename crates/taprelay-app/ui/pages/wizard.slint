import { Button } from "../vendor/components/button.slint";
import { Tokens } from "../vendor/theme/tokens.slint";
import { ScrollArea } from "../vendor/components/scroll-area.slint";
import { I18n } from "@i18n";
import { BindingRow, DeviceRow, RelayStatus } from "../types.slint";
import { Heading, Label, ErrorBanner } from "../components/primitives.slint";
import { RelayStatusCard, AdminAlert } from "../components/runtime-panels.slint";
import { BindingsPage } from "bindings.slint";
import { DevicesPage } from "devices.slint";
import { BluetoothStatus } from "../components/bluetooth-status.slint";
import { ReceiverActions } from "../components/receiver-actions.slint";

export component WizardPage inherits VerticalLayout {
    in property <[BindingRow]> bindings;
    in property <string> capture-error;
    in property <int> capture-index: -1;
    in property <string> capture-text;
    in property <[string]> capture-keys;
    in property <bool> elevated;
    in property <string> problem;
    in property <RelayStatus> relay-status;
    in property <bool> receiver-next-allowed;
    in property <string> discovery-status;
    in property <string> adapter-label;
    in property <bool> scanning;
    in property <[DeviceRow]> paired-devices;
    in property <bool> bluetooth-available;
    in property <bool> busy;
    in property <color> signal;
    in property <string> stage;
    in property <string> stage-detail;
    in property <int> step;
    callback action(string, int, string);
    spacing: 16px;
    Rectangle {
        height: 4px;
        vertical-stretch: 0;
        border-radius: 2px;
        background: Tokens.color-muted;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * clamp(root.step, 0, 3) / 3;
            height: parent.height;
            border-radius: 2px;
            background: Tokens.color-primary;
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Heading {
            horizontal-stretch: 0;
            text: [I18n.text.wizard-bindings,I18n.text.wizard-receiver,I18n.text.wizard-test][root.step];
        }
        if root.step == 1: BluetoothStatus {
            available: root.bluetooth-available;
            busy: root.busy;
            status-label: root.adapter-label;
        }
        if root.step == 1: Rectangle { horizontal-stretch: 1; }
        if root.step == 1: ReceiverActions {
            action(name, index, value) => { root.action(name, index, value); }
        }
    }
    if root.step == 2 && !root.elevated: AdminAlert {
        action(name, index, value) => { root.action(name, index, value); }
    }
    if root.problem != "" && root.step != 1: ErrorBanner {
        problem: root.problem;
        action(name,index,value) => {
            root.action(name,index,value);
        }
    }
    if root.step == 0: BindingsPage {
        bindings: root.bindings;
        capture-error: root.capture-error;
        capture-index: root.capture-index;
        capture-text: root.capture-text;
        capture-keys: root.capture-keys;
        action(name, index, value) => {
            root.action(name, index, value);
        }
    }
    if root.step == 1: DevicesPage {
        discovery-status: root.discovery-status;
        scanning: root.scanning;
        paired-devices: root.paired-devices;
        action(name, index, value) => {
            root.action(name, index, value);
        }
    }
    if root.step == 2: ScrollArea {
        content-height: max(self.height, content.preferred-height);
        content := VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            spacing: 16px;
            Label { text: I18n.text.wizard-input-count + root.relay-status.input-count; }
            RelayStatusCard {
                relay-status: root.relay-status;
                action(name, index, value) => {
                    root.action(name, index, value);
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 12px;
        Button {
            text: I18n.text.wizard-skip;
            variant: ghost;
            clicked=> {
                root.action("wizard-finish",0,"");
            }
        }
        Button {
            text: I18n.text.wizard-back;
            variant: outline;
            disabled: root.step == 0 || root.capture-index != -1;
            clicked=> {
                root.action("wizard-back",0,"");
            }
        }
        Button {
            text: root.step == 2 ? I18n.text.wizard-finish : I18n.text.wizard-next;
            disabled: root.capture-index != -1 || (root.step == 1 && !root.receiver-next-allowed);
            clicked=> {
                root.action(root.step == 2 ? "wizard-finish" : "wizard-next",0,"");
            }
        }
    }
}
