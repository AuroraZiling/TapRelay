import { IconDisplay, IconSet } from "@lucide";
import { Tokens } from "../vendor/theme/tokens.slint";

export component BreadcrumbSeparator inherits Rectangle {
    width: 20px;
    height: 20px;
    horizontal-stretch: 0;
    IconDisplay {
        y: (parent.height - self.height) / 2;
        icon: IconSet.ChevronRight;
        size: 20px;
        stroke: Tokens.color-muted-foreground;
    }
}
