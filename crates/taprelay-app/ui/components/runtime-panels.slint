import { Button } from "../vendor/components/button.slint";
import { Alert } from "../vendor/components/alert.slint";
import { I18n } from "@i18n";
import { RelayStatus } from "../types.slint";
import { Heading, Caption, Label, Panel, StatusDot } from "../components/primitives.slint";

component TapRipple inherits Rectangle {
    in property <int> sequence;
    in property <color> signal;
    in property <length> radius;
    in property <length> center-x;
    in property <length> center-y;
    private property <int> previous;
    private property <float> progress: 1;
    private property <color> wave-color;
    init => { root.previous = root.sequence; }
    changed sequence => {
        if root.sequence > root.previous {
            root.wave-color = root.signal;
            root.progress = 0;
        }
        root.previous = root.sequence;
    }
    Timer {
        interval: 16ms;
        running: root.progress < 1;
        triggered => { root.progress = min(1, root.progress + 0.02); }
    }
    x: root.center-x - self.width / 2;
    y: root.center-y - self.height / 2;
    width: 10px + 2 * root.radius * root.progress;
    height: self.width;
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: root.wave-color.with-alpha(0.45 * (1 - root.progress));
    background: transparent;
    visible: root.progress < 1;
}

export component RelayStatusCard inherits Panel {
    in property <RelayStatus> relay-status;
    clip: true;
    callback action(string, int, string);
    for slot in 16: TapRipple {
        sequence: floor((root.relay-status.input-count + 15 - slot) / 16);
        signal: root.relay-status.signal;
        center-x: status-row.x + status-dot.x + status-dot.width / 2;
        center-y: status-row.y + status-dot.y + status-dot.height / 2;
        radius: sqrt((root.width / 1px) * (root.width / 1px) + (root.height / 1px) * (root.height / 1px)) * 1px;
    }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        Caption {
            text: I18n.text.receiver-current;
        }
        Heading {
            text: root.relay-status.device-name;
        }
        status-row := HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            status-dot := StatusDot {
                signal: root.relay-status.signal;
                dot-size: 10px;
            }
            Label {
                text: root.relay-status.stage;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            Button {
                text: root.relay-status.listening ? I18n.text.listening-stop : I18n.text.listening-start;
                clicked=> {
                    root.action("listen",0,"");
                }
            }
            Button {
                text: I18n.text.receiver-test;
                variant: outline;
                disabled: !root.relay-status.ready;
                clicked=> {
                    root.action("test",0,"");
                }
            }
            if root.relay-status.show-retry: Button {
                text: I18n.text.common-retry;
                variant: ghost;
                clicked=> {
                    root.action("retry",0,"");
                }
            }
        }
        if root.relay-status.test-result != "": Caption {
            text: root.relay-status.test-result;
        }
    }
}
// Business-specific content only; layout and actions belong to Alert.
export component AdminAlert inherits Alert {
    callback action(string, int, string);
    variant: destructive;
    title: I18n.text.permissions-warning;
    action-label: I18n.text.permissions-restart-short;
    action-clicked => { root.action("elevate", 0, ""); }
}
