import { Tokens } from "../vendor/theme/tokens.slint";
import { I18n } from "@i18n";
import { BindingRow, RelayStatus } from "../types.slint";
import { IconButton } from "../components/icon-button.slint";
import { Label, Panel, Caption } from "../components/primitives.slint";
import { RelayStatusCard, AdminAlert } from "../components/runtime-panels.slint";
import { IconSet } from "@lucide";
import { Navigation } from "../navigation.slint";
import { ShortcutPill } from "../components/shortcut-keys.slint";

export component OverviewPage inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;
    in property <[BindingRow]> bindings;
    in property <int> binding-count;
    in property <bool> elevated;
    in property <RelayStatus> relay-status;
    callback action(string, string);
    content := VerticalLayout {
        width: parent.width;
        height: root.height;
        spacing: 16px;
        if !root.elevated: AdminAlert {
            action(name, value) => { root.action(name, value); }
        }
        Rectangle {
            min-height: 0px;
            preferred-height: 0px;
            vertical-stretch: 1;
            GridLayout {
                width: parent.width;
                height: parent.height;
                spacing: 16px;
                Row {
                    Rectangle {
                        height: 180px;
                        clip: true;
                        RelayStatusCard {
                            width: parent.width;
                            height: parent.height;
                            relay-status: root.relay-status;
                            action(name, value) => { root.action(name, value); }
                        }
                    }
                }
                Row {
                    Panel {
                        min-height: 0px;
                        preferred-height: 0px;
                        vertical-stretch: 1;
                        clip: true;
                        Caption {
                            x: 20px;
                            y: 20px;
                            text: I18n.text.overview-bindings;
                        }
                        if root.binding-count > 0: Rectangle {
                            x: 20px;
                            y: 52px;
                            width: max(0px, parent.width - 40px);
                            height: max(0px, parent.height - self.y - 20px);
                            clip: true;
                            FlexboxLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing-horizontal: Tokens.spacing-sm;
                                spacing-vertical: Tokens.spacing-sm;
                                flex-direction: row;
                                flex-wrap: wrap;
                                alignment: start;
                                cross-axis-line-alignment: start;
                                cross-axis-alignment: center;
                                for binding in root.bindings: ShortcutPill {
                                    text: binding.text;
                                    visible: binding.enabled;
                                    accessible-role: text;
                                    accessible-label: binding.text;
                                    accessible-description: binding.function-name;
                                    Tooltip { text: @markdown("\{binding.function-name}"); }
                                }
                            }
                        }
                        settings-button := IconButton {
                            x: parent.width - self.width - Tokens.spacing-sm;
                            y: Tokens.spacing-sm;
                            z: 1;
                            size: icon;
                            width: 36px;
                            icon: IconSet.Settings;
                            hint: I18n.text.overview-manage;
                            clicked=> {
                                root.action("navigate", "\{Navigation.bindings.page}");
                            }
                        }
                    }
                }
            }
        }
    }
}
